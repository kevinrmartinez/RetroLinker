<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:st="clr-namespace:RetroLinker.Styles"
        xmlns:tl="clr-namespace:RetroLinker.Translations">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="check"/>
                    <Button Classes="trash"/>
                    <Button Classes="clear_text"/>
                    <Button Classes="add"/>
                    <Button Classes="clear_list"/>
                    <Button Classes="restore"/>
                    <Button Classes="browseFolder"/>
                    <Button Classes="browseFile"/>
                    <ToggleButton Classes="LockToggle"/>
                    <st:IconFontWithTip IconValue="fa7-x" Tip="biiiiiii"/>
                </StackPanel>
                <st:CheckBoxWithLock Text="biiiiiii"/>
                <st:TextBoxWithLock Label="LOL" Text="bibibi"/>
                <st:ViewControlButton Classes="ExtraControl"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Here goes simple buttons, panels, etc. that are used across the whole app, -->
    <!-- being either custom-made classes, or just styles -->
    <Style Selector="Button.textbox_inline">
        <Setter Property="FontSize" Value="18"/>
    </Style>
    
    <Style Selector="Button.check">
        <Setter Property="i:Attached.Icon" Value="fa7-check"/>
        <Setter Property="Foreground" Value="ForestGreen"/>
    </Style>
    
    <Style Selector="Button.trash">
        <Setter Property="i:Attached.Icon" Value="fa7-trash"/>
        <Setter Property="Foreground" Value="Firebrick"/>
    </Style>
    
    <Style Selector="Button.clear_text">
        <Setter Property="i:Attached.Icon" Value="fa7-delete-left"/>
        <Setter Property="Foreground" Value="Firebrick"/>
    </Style>
    
    <Style Selector="Button.add">
        <Setter Property="i:Attached.Icon" Value="fa7-plus"/>
        <Setter Property="Foreground" Value="ForestGreen"/>
        <Setter Property="ToolTip.Tip" Value="{x:Static tl:resGeneric.btnAdd}"/>
    </Style>
    
    <Style Selector="Button.clear_list">
        <Setter Property="i:Attached.Icon" Value="fa7-eraser"/>
        <Setter Property="Foreground" Value="Firebrick"/>
        <Setter Property="ToolTip.Tip" Value="{x:Static tl:resGeneric.btnClear}"/>
    </Style>
    
    <Style Selector="Button.restore">
        <Setter Property="i:Attached.Icon" Value="fa7-arrow-rotate-left"/>
        <Setter Property="Foreground" Value="Firebrick"/>
    </Style>
    
    <Style Selector="Button.browseFolder">
        <Setter Property="i:Attached.Icon" Value="fa7-folder-closed"/>
        <Setter Property="ToolTip.Tip" Value="{x:Static tl:resGeneric.tipBrowseFolder}"/>
    </Style>
    
    <Style Selector="Button.browseFile">
        <Setter Property="i:Attached.Icon" Value="fa7-folder-open"/>
        <Setter Property="ToolTip.Tip" Value="{x:Static tl:resGeneric.tipBrowseFile}"/>
    </Style>
    
    <Style Selector="st|IconFontWithTip">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="0" Background="Transparent" ToolTip.Tip="{TemplateBinding Tip}">
                    <!-- The ToolTip misbehaves with a null background -->
                    <i:Icon Name="PART_Icon" Value="{TemplateBinding IconValue}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="ToggleButton.LockToggle">
        <Setter Property="Content">
            <Template>
                <!-- The Binding here is a Hack -->
                <i:Icon x:Name="PART_Icon"  Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            </Template>
        </Setter>
        
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Tag" Value="fa7-lock-open"/>
        <Style Selector="^:checked">
            <Setter Property="Tag" Value="fa7-lock"/>
        </Style>
    </Style>
    
    <Style Selector="st|CheckBoxWithLock">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel x:Name="PART_Panel">
                    <ToggleButton x:Name="PART_Lock" Classes="LockToggle" 
                                  IsChecked="{TemplateBinding IsLocked, Mode=TwoWay}"/>
                    <CheckBox x:Name="PART_CheckBox" Content="{TemplateBinding Text}"
                              IsChecked="{TemplateBinding IsChecked, Mode=TwoWay}"/>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ StackPanel#PART_Panel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="2"/>
        </Style>
    </Style>
    
    <Style Selector="st|TextBoxWithLock">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel x:Name="PART_DockPanel">
                    <ToggleButton x:Name="PART_Lock" DockPanel.Dock="Left" Classes="LockToggle" 
                                  IsChecked="{TemplateBinding IsLocked, Mode=TwoWay}"/>
                    <Label x:Name="PART_Label" DockPanel.Dock="Left" Content="{TemplateBinding Label}"/>
                    <TextBox x:Name="PART_TextBox" Text="{TemplateBinding Text, Mode=TwoWay}"/>
                </DockPanel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ Label#PART_Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Style>
    
    <Style Selector="Button.ExtraControl">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10"/>
        
        <Style Selector="^ > StackPanel">
            <Setter Property="Spacing" Value="6"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            
            <Style Selector="^ > i|Icon">
                <Setter Property="FontSize" Value="18"/>
            </Style>
            
            <Style Selector="^ > TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Style>
    </Style>
    
</Styles>
