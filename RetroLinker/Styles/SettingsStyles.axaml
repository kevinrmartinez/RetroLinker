<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:st="clr-namespace:RetroLinker.Styles">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
          <StackPanel>
              <st:LightDivider/>
              <Border Classes="section-box setting-group">
                  <StackPanel>
                      <Label Content="Label"/>
                      <Button Content="Button"/>
                      <CheckBox Content="CHECKBOX"/>
                  </StackPanel>
              </Border>
              <st:LightDivider/>
          </StackPanel> 
        </Border>
    </Design.PreviewWith>

    <!-- <StyleInclude Source="SimpleCustomControls.axaml"/> -->
    <StyleInclude Source="ComplexCustomControls.axaml"/>
    
    <!-- Add Styles Here -->
    <Style Selector="Border.setting-group">
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="9"/>
        
        <Style Selector="^ > StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
        </Style>
        
        <Style Selector="^ CheckBox">
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Style>
</Styles>
