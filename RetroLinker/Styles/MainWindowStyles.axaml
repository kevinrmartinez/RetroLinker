<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:md="clr-namespace:RetroLinker.Models"
        xmlns:st="clr-namespace:RetroLinker.Styles"
        xmlns:vw="clr-namespace:RetroLinker.Views">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <StackPanel Orientation="Vertical">
                <Label Content="Cores" Classes="ReqField"/>
                <ItemsControl x:Name="lstEnvVars" ItemsSource="{x:Static st:DummyData.DummyEnvVars}"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <StyleInclude Source="ComplexCustomControls.axaml"/>
    
    <Styles.Resources>
        <x:Double x:Key="VariableMinWidth">170</x:Double>
    </Styles.Resources>
    
    <!-- Main View Body -->
    
    <!-- Section Labes -->
    <Style Selector="Label.ReqField">
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <TextBlock>
                    <Run Text="{Binding Content,
                    RelativeSource={RelativeSource FindAncestor, AncestorType=Label}}"/>
                    <Run Text="*" Foreground="Crimson"/>
                </TextBlock>
            </DataTemplate>
        </Setter>
    </Style>
    
    <!-- comboCore -->
    <Style Selector="AutoCompleteBox#comboCore">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
    </Style>
    
    <Style Selector="Label.minor_error">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="DarkRed"/>
    </Style>
    
    <!-- Icons Viewboxes -->
    <!-- SOON -->
    
    <!-- == More Options View == -->
    <!-- Env -->
    <Style Selector="ItemsControl#lstEnvVars">
        <Setter Property="ItemTemplate">
            <DataTemplate DataType="md:EnvironmentVariable">
                <Border x:Name="PART_TopBorder">
                    <Grid x:Name="PART_Grid" ColumnDefinitions="Auto,0.4*,*,Auto">
                        <ToggleButton x:Name="PART_Lock" Grid.Column="0" Classes="LockToggle" 
                                      CommandParameter="{x:Static vw:UserListActions.Lock}"/>
                        <SelectableTextBlock x:Name="PART_TextKey" Grid.Column="1" Text="{Binding Key}" 
                                             ToolTip.Tip="{Binding $self.Text}"/>
                        <TextBox x:Name="PART_TextValue" Grid.Column="2" Text="{Binding Value}" 
                                 ToolTip.Tip="{Binding $self.Text}"/>
                        <Button x:Name="PART_Trash" Grid.Column="3" Classes="textbox_inline trash" 
                                Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{x:Static vw:UserListActions.Remove}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </Setter>
        
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SystemControlPageBackgroundBaseLowBrush}"/>
        
        <Style Selector="^ Border#PART_TopBorder">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="^ Grid#PART_Grid">
            <Setter Property="ColumnSpacing" Value="2"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style Selector="^ ToggleButton#PART_Lock"></Style>
        <Style Selector="^ SelectableTextBlock#PART_TextKey">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style Selector="^ TextBox#PART_TextValue">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Style>
    
    <Style Selector="Viewbox.Expandable">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:00:00.27" Easing="CubicEaseOut"/>
                <DoubleTransition Property="Height" Duration="0:00:00.27" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    
        <Setter Property="Width" Value="0"/>
        <Setter Property="Height" Value="0"/>
        <Style Selector="^.Expanded">
            <!-- If both of these are unset (set to NaN), it breaks the transition -->
            <!-- Solution inspired by https://deepwiki.com/AvaloniaCommunity/Material.Avalonia/4.3-animations-and-transitions#control-style-integration-examples -->
            <Setter Property="Width" Value="{x:Static x:Double.NaN}"/>
            <Setter Property="Height" Value="{Binding $self.Tag}"/>
        </Style>
    </Style>
    
    <!-- == Extra Views == -->
    <!-- AppendView -->
    <Style Selector="Border.AppendControls">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="4"/>
    </Style>
</Styles>
