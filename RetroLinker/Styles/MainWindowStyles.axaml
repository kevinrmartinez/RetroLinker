<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:vw="clr-namespace:RetroLinker.Views"
        xmlns:st="clr-namespace:RetroLinker.Styles"
        xmlns:md="clr-namespace:RetroLinker.Models">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
            <StackPanel Orientation="Vertical">
                <Label Content="Cores" Classes="ReqField"/>
                <ToggleButton Classes="LockToggle"/>
                <ItemsControl x:Name="listEnvVars" ItemsSource="{x:Static st:DummyData.DummyEnvVars}"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <StyleInclude Source="ComplexCustomControls.axaml"/>
    
    <Styles.Resources>
        <x:Double x:Key="VariableMinWidth">170</x:Double>
    </Styles.Resources>
    
    <!-- Main View Body -->
    
    <!-- Section Labes -->
    <Style Selector="Label.ReqField">
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <TextBlock>
                    <Run Text="{Binding Content,
                    RelativeSource={RelativeSource FindAncestor, AncestorType=Label}}"/>
                    <Run Text="*" Foreground="Crimson"/>
                </TextBlock>
            </DataTemplate>
        </Setter>
    </Style>
    
    <!-- comboCore -->
    <Style Selector="AutoCompleteBox#comboCore">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
    </Style>
    
    <Style Selector="Label.minor_error">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="DarkRed"/>
    </Style>
    
    <!-- Icons Viewboxes -->
    <!-- SOON -->
    
    <!-- == More Options View == -->
    <!-- Lock Toggle -->
    <Style Selector="ToggleButton.LockToggle">
        <Setter Property="Content">
            <Template>
                <i:Icon x:Name="PART_Icon"  Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            </Template>
        </Setter>
        
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Tag" Value="fa7-lock-open"/>
        <Style Selector="^:checked">
            <Setter Property="Tag" Value="fa7-lock"/>
        </Style>
    </Style>
    
    <!-- Env -->
    <Style Selector="ItemsControl#listEnvVars">
        <Setter Property="ItemTemplate">
            <DataTemplate DataType="md:EnvironmentVariable">
                <Border Margin="2,3" BorderThickness="0,0,0,1" BorderBrush="Gray" 
                        CornerRadius="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <DockPanel Margin="4" HorizontalSpacing="2">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" TextAlignment="Right"
                               MinWidth="{StaticResource VariableMinWidth}" 
                               Text="{Binding Key}" ToolTip.Tip="{Binding $self.Text}"/>
                        <Button DockPanel.Dock="Right" Classes="textbox_inline trash" 
                                Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding $self}" Command="{x:Static vw:GlobalCommands.TrashFromListCommand}"/>
                        <TextBox IsReadOnly="True" Text="{Binding Value}" ToolTip.Tip="{Binding $self.Text}"/>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </Setter>
        
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource SystemControlPageBackgroundBaseLowBrush}"/>
    </Style>
    
    <Style Selector="Viewbox.Expandable">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:00:00.27" Easing="CubicEaseOut"/>
                <DoubleTransition Property="Height" Duration="0:00:00.27" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    
        <Setter Property="Width" Value="0"/>
        <Setter Property="Height" Value="0"/>
        <Style Selector="^.Expanded">
            <!-- If both of these are unset (set to NaN), it breaks the transition -->
            <!-- Solution inspired by https://deepwiki.com/AvaloniaCommunity/Material.Avalonia/4.3-animations-and-transitions#control-style-integration-examples -->
            <Setter Property="Width" Value="{x:Static x:Double.NaN}"/>
            <Setter Property="Height" Value="{Binding $self.Tag}"/>
        </Style>
    </Style>
    
    <!-- == Extra Views == -->
    <!-- AppendView -->
    <Style Selector="Border.AppendControls">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="4"/>
    </Style>
</Styles>
