<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vw="clr-namespace:RetroLinker.Views"
             xmlns:pc="clr-namespace:RetroLinker.Styles"
             xmlns:lc="clr-namespace:RetroLinker.Translations"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
             x:Class="RetroLinker.Views.SubsystemsView"
             x:DataType="vw:SubsystemsView"
             x:CompileBindings="True">
    <UserControl.Styles>
        <StyleInclude Source="../Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>
    
    <!-- TODO: Localization support -->
    <Grid x:Name="gridContent" RowDefinitions="Auto, *, Auto">
        <!--Top-->
        <pc:MainWindowHeader Grid.Row="0" Title="{x:Static lc:resMainExtras.titleSubsystems}" Classes="Header"/>
        <!-- Header -->
    
        <!--Body-->
        <Grid x:Name="gridBody" Grid.Row="1" RowDefinitions="Auto, *, Auto, Auto">
    
            <!-- ROW0 - Spacing -->
            <Rectangle Grid.Row="0" Height="8"/>
    
            <!-- ROW1 - Subsystem Controls -->
            <Grid x:Name="gridControls" Grid.Row="1" ColumnDefinitions="*,4*" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10,0">
                
                <Label Grid.Column="0" Grid.Row="0" Content="Core: " 
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="0" IsEnabled="False" Margin="0,3" Text="{Binding Core}"/>
                    
                <Label Grid.Column="0" Grid.Row="1" Content="Content: " 
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="1" IsEnabled="False" Margin="0,3" Text="{Binding CoreContent}"/>
                    
                <Label Grid.Column="0" Grid.Row="2" Content="Subsystem: " 
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSubsys" Grid.Column="1" Grid.Row="2" Margin="0,3" Text="{Binding SubSystem}"/>
                    
                <Label Grid.Column="0" Grid.Row="3" Content="Arguments: " 
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3"/>
                <Border Grid.Column="1" Grid.Row="3" BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Margin="0,3">
                    <pc:UserStringList x:Name="ArgsList" Items="{Binding Arguments}" AddItemClick="ArgsList_OnAddItemClick" PropertyChanged="ArgsList_OnPropertyChanged"
                                       IsEnabled="{Binding #txtSubsys.Text, Mode=OneWay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </Border>
                
                <Border x:Name="BorderNewArg" Grid.Column="1" Grid.Row="4" IsVisible="False"
                        BorderThickness="1" BorderBrush="Gray" CornerRadius="4" Margin="0,3">
                    <StackPanel Orientation="Vertical">
                        <Label Content="New Argument:"/>
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="2">
                            <TextBox x:Name="TextBoxNewArg" Grid.Column="0" Text="{Binding NewArgument, Mode=TwoWay}"/>
                            <Button Grid.Column="1" Content="⌫" FontSize="18" Classes="clear_text" Click="ButtonNewArgDiscard_OnClick"/>
                            <Button Grid.Column="2" Content="✓" FontSize="18" Classes="check" Click="ButtonNewArgAccept_OnClick"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- ROW2 - Spacing -->
            <Rectangle Grid.Row="2" Height="10"/>
            
            <!-- ROW3 - Return Controls -->
            <Grid Grid.Row="3" HorizontalAlignment="Stretch" ColumnDefinitions="*, *" Margin="3,5">
                <pc:ExtraMainControlButton x:Name="btnSavePatch" Grid.Column="0" ButtonFunction="Save" Classes="ExtraControl" Click="BtnSavePatch_OnClick"/>
                <pc:ExtraMainControlButton x:Name="btnDiscPatch" Grid.Column="1" ButtonFunction="Discard" Classes="ExtraControl" Click="BtnDiscPatch_OnClick"/>
            </Grid>
            
        </Grid>
    
        <!--Bottom-->
        <!-- <Grid Name="gridBOTTOM" Grid.Row="2" Height="40" ColumnDefinitions="Auto, *, Auto" Background="Gray"> -->
        <!--      -->
        <!-- </Grid> -->
    </Grid>
</UserControl>
