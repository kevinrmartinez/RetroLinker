<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:st="clr-namespace:RetroLinker.Styles"
             xmlns:tl="clr-namespace:RetroLinker.Translations"
             xmlns:vw="clr-namespace:RetroLinker.Views"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
             x:Class="RetroLinker.Views.SubsystemsView"
             x:DataType="vw:SubsystemsView" DataContext="{Binding $self}">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>
    
    <Grid x:Name="gridContent" RowDefinitions="Auto, *, Auto">
        <!-- Top/Header -->
        <st:MainWindowHeader Grid.Row="0" Title="{x:Static tl:resMainExtras.titleSubsystems}" Classes="Header"/>
    
        <!-- Body -->
        <DockPanel x:Name="gridBody" Grid.Row="1">
    
            <!-- Top Spacing -->
            <Rectangle DockPanel.Dock="Top" Height="8"/>
            
            <!-- Return Controls -->
            <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" ColumnDefinitions="*, *" Margin="3,5">
                <st:ViewControlButton x:Name="btnSavePatch" Grid.Column="0" ButtonFunction="Save" Classes="ExtraControl" Click="BtnSaveSubsystem_OnClick"/>
                <st:ViewControlButton x:Name="btnDiscPatch" Grid.Column="1" ButtonFunction="Discard" Classes="ExtraControl" Click="BtnDiscSubsystem_OnClick"/>
            </Grid>
    
            <!-- Subsystem Controls -->
            <Grid x:Name="gridControls" ColumnDefinitions="*,6*" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="10,2">
                
                <Label Grid.Column="0" Grid.Row="0" Content="{x:Static tl:resMainExtras.lblSubsysCore}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCore" Grid.Column="1" Grid.Row="0" IsEnabled="False" Margin="0,3" Text="{Binding Core}"/>
                    
                <Label Grid.Column="0" Grid.Row="1" Content="{x:Static tl:resMainExtras.lblSubsysContent}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txtContent" Grid.Column="1" Grid.Row="1" IsEnabled="False" Margin="0,3" Text="{Binding CoreContent}"/>
                
                <st:DashDivider Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,3"/>
                    
                <Label Grid.Column="0" Grid.Row="3" Content="{x:Static tl:resMainExtras.lblSubsysBase}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSubsys" Grid.Column="1" Grid.Row="3" Margin="0,3" Text="{Binding SubSystem}"/>
                    
                <Label Grid.Column="0" Grid.Row="4" Content="{x:Static tl:resMainExtras.lblSubsysArgs}" 
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3"/>
                <Border Grid.Column="1" Grid.Row="4" Classes="section-box" Margin="0,3">
                    <st:UserStringList x:Name="ArgsList" Items="{Binding Arguments}" AddItemClick="ArgsList_OnAddItemClick" PropertyChanged="ArgsList_OnPropertyChanged"
                                       CanAdd="{Binding !AddingNewArgument}" CanClear="{Binding $self.Items.Count}"
                                       IsEnabled="{Binding SubSystem, Mode=OneWay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </Border>
                
                <Border x:Name="BorderNewArg" Grid.Column="1" Grid.Row="5" Classes="section-box Expandable" Margin="0,3"
                        Classes.Expanded="{Binding AddingNewArgument, Mode=OneWay}">
                    <Border.Styles>
                        <Style Selector="Border.Expanded">
                            <Setter Property="Height" Value="62"/>
                        </Style>
                    </Border.Styles>
                    
                    <StackPanel Orientation="Vertical">
                        <Label Content="{x:Static tl:resMainExtras.lblSubsysNewArg}"/>
                        <DockPanel Margin="2">
                            <Button DockPanel.Dock="Right" Classes="textbox_inline check" Click="ButtonNewArgAccept_OnClick"
                                    IsEnabled="{Binding NewArgument, 
                                    Converter={x:Static st:StringsBindingConverters.IsNotNullOrWhiteSpace}}"
                                    ToolTip.Tip="{x:Static tl:resMainExtras.btnSubsysArgAdd_Tip}"/>
                            <Button DockPanel.Dock="Right" Classes="textbox_inline clear_text" Click="ButtonNewArgDiscard_OnClick"
                                    ToolTip.Tip="{x:Static tl:resMainExtras.btnSubsysArgDis_Tip}"/>
                            <Button DockPanel.Dock="Right" Classes="textbox_inline browseFile" Click="ButtonNewArgBrowse_OnClick"/>
                            
                            <TextBox x:Name="TextBoxNewArg" Text="{Binding NewArgument, Mode=TwoWay}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            
        </DockPanel>
    
        <!-- Bottom -->
        <!-- <Grid Name="gridBOTTOM" Grid.Row="2" Height="40" ColumnDefinitions="Auto, *, Auto" Background="Gray"> -->
        <!-- </Grid> -->
    </Grid>
</UserControl>
