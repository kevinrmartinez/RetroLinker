<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:se="clr-namespace:RetroLinker.Models.Settings"
             xmlns:st="clr-namespace:RetroLinker.Styles"
             xmlns:tl="clr-namespace:RetroLinker.Translations"
             xmlns:vw="clr-namespace:RetroLinker.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="RetroLinker.Views.MoreRaOptionsView"
             x:DataType="vw:MoreRaOptionsView"
             x:CompileBindings="True"
             NewEnvVar_Valid="{Binding NewEnvVar_Key, 
             Converter={x:Static StringConverters.IsNotNullOrEmpty}, Mode=OneWay}">
    
    <UserControl.Styles>
        <StyleInclude Source="../Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>
    
    <DockPanel Margin="3">
        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="4">
            <Rectangle Height="10"/>
            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0" DockPanel.Dock="Left" Orientation="Vertical" Margin="1,0">
                    <st:CheckBoxWithLock Text="{x:Static tl:resMainView.chkFull}"
                                         IsChecked="{Binding LinkBuilder.RaFullscreen}"
                                         LockedValueIn="{Binding UserChoices.StoredRaFullscreen, Mode=OneTime}"
                                         LockedValueOut="{Binding UserChoices.StoredRaFullscreen, Mode=OneWayToSource}"/>
                    <st:CheckBoxWithLock Text="{x:Static tl:resMainView.chkVerb}"
                                         IsChecked="{Binding LinkBuilder.RaVerbose}"
                                         LockedValueIn="{Binding UserChoices.StoredVerbose, Mode=OneTime}"
                                         LockedValueOut="{Binding UserChoices.StoredVerbose, Mode=OneWayToSource}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="1,0">
                    <st:CheckBoxWithLock Text="{x:Static tl:resMainView.chkAccessi}"
                                         IsChecked="{Binding LinkBuilder.RaAccessibility}"
                                         LockedValueIn="{Binding UserChoices.StoredRaAccessibility, Mode=OneTime}"
                                         LockedValueOut="{Binding UserChoices.StoredRaAccessibility, Mode=OneWayToSource}"/>
                    <st:CheckBoxWithLock Text="{x:Static tl:resMainView.chkMenuOnError}"
                                         IsChecked="{Binding LinkBuilder.RaMenuOnError}"
                                         LockedValueIn="{Binding UserChoices.StoredRaMenuOnError, Mode=OneTime}"
                                         LockedValueOut="{Binding UserChoices.StoredRaMenuOnError, Mode=OneWayToSource}"/>
                </StackPanel>
            </Grid>
            
            <DockPanel>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Classes="textbox_inline clear_text" 
                        CommandParameter="{x:Static vw:TextBoxActions.Clear}" Click="BtnRaLogFile_OnClick"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Classes="textbox_inline browseFile" 
                        CommandParameter="{Binding #txtLogFile}" Click="BtnRaLogFile_OnClick"/>
                <st:TextBoxWithLock x:Name="txtLogFile" Label="{x:Static tl:resMainExtras.lblLogFile}" 
                                    Text="{Binding LinkBuilder.RaLogFile}"
                                    LockedValueIn="{Binding UserChoices.StoredRaLogFile, Mode=OneTime}"
                                    LockedValueOut="{Binding UserChoices.StoredRaLogFile, Mode=OneWayToSource}"/>
            </DockPanel>
            
            <Rectangle Height="20"/>
            <Label Content="{x:Static tl:resMainExtras.lblCat_EnvVar}" FontWeight="Bold"/>
            <Border BorderThickness="1" CornerRadius="6" 
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                <StackPanel Orientation="Vertical" Spacing="2" Margin="2">
                    <ItemsControl x:Name="lstEnvVars" ItemsSource="{Binding LinkBuilder.EnvironmentVariables}"
                                  Tag="{Binding HalfWidth, RelativeSource={RelativeSource AncestorType=vw:PopUpWindow}}"
                                  Loaded="LstEnvVars_ButtonOnLoaded" Button.Click="LstEnvVars_ButtonOnClick"/>
                    
                    <Rectangle StrokeThickness="1" Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    
                    <DockPanel HorizontalSpacing="2">
                        <Button DockPanel.Dock="Right" Classes="textbox_inline browseFolder" CommandParameter="{x:Static vw:TextBoxActions.Browse}"
                                Click="BtnEnvVars_OnClick"/>
                        <ComboBox PlaceholderText="{x:Static tl:resMainExtras.plhEnvVar_Key}" IsEditable="True" 
                                  MinWidth="{StaticResource VariableMinWidth}"
                                  MaxWidth="{Binding HalfWidth, RelativeSource={RelativeSource AncestorType=vw:PopUpWindow}}"
                                  Text="{Binding NewEnvVar_Key}"
                                  ItemsSource="{x:Static se:SettingsOps.RaEnvironmentVariables}"/>
                        <TextBox PlaceholderText="{x:Static tl:resMainExtras.plhEnvVar_Val}" 
                                 Text="{Binding NewEnvVar_Value}"/>
                    </DockPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Viewbox HorizontalAlignment="Right" Classes="Expandable" Tag="{Binding #btnClearList.Bounds.Height}"
                                 Classes.Expanded="{Binding NewEnvVar_Valid, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="textbox_inline add" CommandParameter="{x:Static vw:UserListActions.Add}"
                                        Click="BtnEnvVars_OnClick"/>
                                <Button Classes="textbox_inline clear_text" CommandParameter="{x:Static vw:TextBoxActions.Clear}"
                                        Click="BtnEnvVars_OnClick"/>
                            </StackPanel>
                        </Viewbox>
                        <Button x:Name="btnClearList" Classes="textbox_inline clear_list" CommandParameter="{x:Static vw:UserListActions.Clear}"
                                Click="BtnEnvVars_OnClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <Panel DockPanel.Dock="Bottom">
            <st:ViewControlButton ButtonFunction="Save" Classes="ExtraControl" VerticalAlignment="Bottom" Click="BtnExit_OnClick"/>
        </Panel>
    </DockPanel>
</UserControl>
