<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:st="clr-namespace:RetroLinker.Styles"
             xmlns:tl="clr-namespace:RetroLinker.Translations"
             xmlns:vw="clr-namespace:RetroLinker.Views"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="550"
             x:Class="RetroLinker.Views.SettingsView"
             x:DataType="vw:SettingsView" DataContext="{Binding $self}">
  
	<UserControl.Styles>
		<StyleInclude Source="/Styles/SettingsStyles.axaml"/>
	</UserControl.Styles>
	
	<!-- BODY/CONTENT -->
	<StackPanel x:Name="panelConfigBody" Orientation="Vertical">

		<!-- APPEARANCE -->
		<Border Classes="section-box setting-group">
			<StackPanel>
				<Label Content="{x:Static tl:resSettingsWindow.lblCat_Appearance}"/>
				<st:LightDivider/>
				<Grid ColumnDefinitions="*, Auto, *">
					<StackPanel Grid.Column="0" Orientation="Vertical">
						<Label Content="{x:Static tl:resSettingsWindow.swtThemeSwitch}"/>
						<StackPanel Orientation="Horizontal" Spacing="18">
							<!-- REWRITE: Use Binding somehow -->
							<ToggleSwitch x:Name="swtThemeSwitch" IsCheckedChanged="ThemeSwitch_CheckedChanged"
							              OnContent="{x:Static tl:resSettingsWindow.swtThemeSwitch_On}" 
							              OffContent="{x:Static tl:resSettingsWindow.swtThemeSwitch_Off}"/>
							<CheckBox x:Name="chkThemeDefault" Content="{x:Static tl:resSettingsWindow.chkThemeDefault}" 
							          IsCheckedChanged="ThemeDefault_CheckedChanged"/>
						</StackPanel>
					</StackPanel>
					
					<st:LightDivider Grid.Column="1"/>
					
					<StackPanel Grid.Column="2">
						<Label Margin="3,0,0,0" Content="{x:Static tl:resSettingsWindow.lblLocale}"/>
						<Grid ColumnDefinitions="*, Auto">
							<!-- REWRITE: Show comboLocale content with a DataTemplate (>=0.10) -->
							<ComboBox x:Name="comboLocale" Grid.Column="0" Margin="3,0,0,2" 
							          VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
							<!-- REWRITE: Make this button obsolete (requires Binding?) -->
							<Button x:Name="btnLocale" Grid.Column="1" Margin="3" Click="BtnLocale_OnClick">
								<i:Icon Value="fa7-check" FontSize="18" Foreground="Green"/>
							</Button>
						</Grid>
					</StackPanel>
				</Grid>
			</StackPanel>
		</Border>

		<!-- ICONS -->
		<Border Classes="section-box setting-group">
			<StackPanel>
				<StackPanel Orientation="Horizontal">
					<Label Content="{x:Static tl:resSettingsWindow.lblCat_IconsGeneral}"/>
					<st:IconFontWithTip x:Name="tipDisableBecauseTileIco" IconValue="fa7-ban" 
					                    Tip="{x:Static tl:resSettingsWindow.tipDisableBecauseTileIco}"
					                    IsVisible="{Binding ParentWindow.NewSettings.TileIcoPath, 
					                    Converter={x:Static ObjectConverters.IsNotNull}}"/>
				</StackPanel>
				<st:LightDivider/>
				<CheckBox x:Name="chkCpyUserIcon" Content="{x:Static tl:resSettingsWindow.chkCpyUserIcon}"
				          IsChecked="{Binding ParentWindow.NewSettings.CpyUserIcon}" ToolTip.Tip="{x:Static tl:resSettingsWindow.tipCpyUserIcon}"
				          IsEnabled="{Binding !#tipDisableBecauseTileIco.IsVisible}"/>
			</StackPanel>
		</Border>
		
		<!-- OTHER SETTINGS -->
		<Border Classes="section-box setting-group">
			<StackPanel>
				<Label Content="{x:Static tl:resSettingsWindow.lblCat_OtherGeneral}"/>
				<st:LightDivider/>
				<Grid Margin="0,3" ColumnDefinitions="*,Auto,*" ShowGridLines="False">
					<StackPanel Grid.Column="0" Orientation="Vertical">
						<CheckBox x:Name="chkPrevCONFIG" Content="{x:Static tl:resSettingsWindow.chkPrevCONFIG}" 
						          IsChecked="{Binding ParentWindow.NewSettings.PrevConfig}"/>
					</StackPanel>
				</Grid>
			</StackPanel>
		</Border>

	</StackPanel>
</UserControl>
