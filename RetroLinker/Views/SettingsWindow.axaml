<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pc="clr-namespace:RetroLinker.Styles"
        xmlns:lc="clr-namespace:RetroLinker.Translations"
        mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="550"
        Width="750" Height="550" MinWidth="600" MinHeight="530"
        x:Class="RetroLinker.Views.SettingsWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static lc:resSettingsWindow.wndTitle}"
        WindowStartupLocation="CenterScreen"
		ScrollViewer.AllowAutoHide="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
	
	<Window.Styles>
		<StyleInclude Source="/Styles/SettingsStyles.axaml"/>
	</Window.Styles>
	
	<Grid x:Name="gridConfigWindows" RowDefinitions="Auto, *, Auto, Auto">
		<!--TOP-->
		<!-- <Rectangle Grid.Row="0" Fill="Gray" Height="15"/> -->
		
		<!-- BODIES TAB CONTROL -->
		<!-- The views 'DataContext' should be refreshed: -->
		<!--	- On tab selection (controlled by 'AttachedToVisualTree' of CCTabs) -->
		<!--	- On 'LostFocus' of the TextBoxes (when ReadOnly == false) -->
		<!--	- On the 'LockControls()' functions-->
		<!--	- On Buttons modifying content on TextBoxes -->
		<TabControl Grid.Row="1">
			<TabItem Header="{x:Static lc:resSettingsWindow.tabGeneral}">
				<ScrollViewer AllowAutoHide="True" VerticalScrollBarVisibility="Auto">
					<ContentControl x:Name="CCTab1" Margin="0,0,8,0" AttachedToVisualTree="CCTab_OnAttachedToVisualTree"/>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="{x:Static lc:resSettingsWindow.tabPaths}">
				<ScrollViewer AllowAutoHide="True" VerticalScrollBarVisibility="Auto">
					<ContentControl x:Name="CCTab2" Margin="0,0,8,0" AttachedToVisualTree="CCTab_OnAttachedToVisualTree"/>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="{x:Static lc:resSettingsWindow.tabOutput}">
				<ScrollViewer AllowAutoHide="True" VerticalScrollBarVisibility="Auto">
					<ContentControl x:Name="CCTab3" Margin="0,0,8,0" AttachedToVisualTree="CCTab_OnAttachedToVisualTree"/>
				</ScrollViewer>
			</TabItem>
		</TabControl>
		
		<!-- CONTROLS -->
		<Grid Grid.Row="2" Height="48" Margin="3" HorizontalAlignment="Stretch" ColumnDefinitions="*,*,*">
			<pc:ViewControlButton Grid.Column="0" ButtonFunction="Save" Classes="ExtraControl" Click="btnSAVESettings_OnClick"/>
			<pc:ViewControlButton Grid.Column="1" ButtonFunction="Default" Classes="ExtraControl" Click="btnDEFSettings_Click"/>
			<pc:ViewControlButton Grid.Column="2" ButtonFunction="Discard" Classes="ExtraControl" Click="btnDISSettings_OnClick"/>
		</Grid>

		<!--BOTTOM-->
		<!-- <Rectangle Grid.Row="3" Fill="Gray" Height="15"/> -->
	</Grid>
</Window>
