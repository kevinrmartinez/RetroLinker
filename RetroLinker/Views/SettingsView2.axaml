<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vw="using:RetroLinker.Views"
             xmlns:lc="clr-namespace:RetroLinker.Translations"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="550"
             x:Class="RetroLinker.Views.SettingsView2"
             x:DataType="vw:SettingsView2"
             x:CompileBindings="True">
	
	<UserControl.Styles>
		<StyleInclude Source="/Styles/SettingsStyles.axaml"/>
	</UserControl.Styles>
    
	<Grid x:Name="gridConfigAll2" RowDefinitions="Auto, *">
        <!-- CONTENT -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto, Auto, Auto">
            <!-- USER ASSETS -->
			<Border Grid.Row="0" Classes="SettingCatg">
				<StackPanel>
					<Label Content="{x:Static lc:resSettingsWindow.lblCat_AserAssets}"/>
					<Rectangle HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="0.5"/>
					<TextBlock TextWrapping="Wrap" FontSize="12" 
					           Text="{x:Static lc:resSettingsWindow.blcUserAssets}"/>
					<Grid Margin="1,3" ColumnDefinitions="*, Auto, Auto">
						<TextBox x:Name="txtUserAssets" Grid.Column="0" HorizontalAlignment="Stretch" IsReadOnly="True"
						         Text="{Binding ParentWindow.NewSettings.UserAssetsPath, 
						         Converter={StaticResource TextToFullPathConverter}}"
						         LostFocus="TxtBox_OnLostFocus"/>
						<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="btnUserAssets" Classes="textbox_inline browse" Click="btnUserAssets_OnClick"/>
							<Button x:Name="btnclrUserAssets" Classes="textbox_inline restore" Click="btnclrUserAssets_OnClick"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- RA EXECUTABLE -->
			<Border Grid.Row="1" Classes="SettingCatg">
				<StackPanel>
					<Label Content="{x:Static lc:resSettingsWindow.lblCat_DefRADir}"/>
					<Rectangle HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="0.5"/>
					<Grid Margin="1,3" ColumnDefinitions="*, Auto, Auto">
						<TextBox x:Name="txtDefRADir" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" 
						         Text="{Binding ParentWindow.NewSettings.DEFRADir}"
						         IsReadOnly="{Binding DesktopOS}"
						         LostFocus="TxtBox_OnLostFocus"/>
						<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="btnDefRADir" Classes="textbox_inline browse" Click="btnDefRADir_OnClick"/>
							<Button x:Name="btnclrDefRADir" Classes="textbox_inline restore" Click="btnclrDefRADir_Click"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- DEFAULT ROM PATH -->
			<Border Grid.Row="2" Classes="SettingCatg">
				<StackPanel>
					<Label Content="{x:Static lc:resSettingsWindow.lblCat_DefROMPath}"/>
					<Rectangle HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="0.5"/>
					<Grid Margin="1,3" ColumnDefinitions="*, Auto">
						<TextBox x:Name="txtDefROMPath" Grid.Column="0" HorizontalAlignment="Stretch" IsReadOnly="True"
						         Text="{Binding ParentWindow.NewSettings.DEFROMPath}" 
						         LostFocus="TxtBox_OnLostFocus"/>
						<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="btnDefROMPath" Classes="textbox_inline browse" Click="btnDefROMPath_OnClick"/>
							<Button x:Name="btnclrDefROMPath" Classes="textbox_inline restore" Click="btnclrDefROMPath_Click"/>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>
            
        </Grid>
        
    </Grid>
</UserControl>
