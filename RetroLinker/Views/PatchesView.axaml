<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rl="clr-namespace:RetroLinker"
             xmlns:st="clr-namespace:RetroLinker.Styles"
             xmlns:tl="clr-namespace:RetroLinker.Translations"
             xmlns:vw="clr-namespace:RetroLinker.Views"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
             x:Class="RetroLinker.Views.PatchesView"
             x:DataType="vw:PatchesView" DataContext="{Binding $self}">
    
    <UserControl.Resources>
        <x:String x:Key="GroupPatchType">PatchType</x:String>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="../Styles/MainWindowStyles.axaml"/>
    </UserControl.Styles>
    
    <Grid Name="gridContent" RowDefinitions="Auto, *, Auto">
        <!--Top-->
        <st:MainWindowHeader Grid.Row="0" Title="{x:Static tl:resMainExtras.titleSoftPatching}" Classes="Header"/>
        <!-- Header -->
    
        <!--Body-->
        <Grid Name="gridBody" Grid.Row="1" RowDefinitions="Auto, Auto, *, Auto">
    
            <!-- ROW0 - Spacing -->
            <Rectangle Grid.Row="0" Height="8"/>
    
            <!-- ROW1 - Patch Controls -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10,0">
                <Label Content="{x:Static tl:resMainExtras.lblPatchContent}"/>
                <TextBox x:Name="txtCoreContent" IsEnabled="False" Margin="3,0" Text="{Binding CoreContent}"/>
                
                <st:DashDivider Margin="0,6"/>
                
                <Label Content="{x:Static tl:resMainExtras.lblPatchType}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Name="rdoExNoPatch" GroupName="{StaticResource GroupPatchType}"
                                 Content="{x:Static tl:resMainExtras.chkNoPatch}"
                                 ToolTip.Tip="{x:Static vw:PatchesView.ChkNoPatchTip}"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.No_Patch}}"/>
                    <RadioButton Name="rdoNoPatch" GroupName="{StaticResource GroupPatchType}"
                                 Content="{x:Static tl:resMainExtras.rdoNoPatch}"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.None}}"/>
                    <RadioButton Name="rdoAutoPatch" GroupName="{StaticResource GroupPatchType}"
                                 Content="{x:Static tl:resGeneric.btnAuto}"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.Any}}"/>
                    <RadioButton Name="rdoUPSPatch" GroupName="{StaticResource GroupPatchType}" Content="UPS"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.UPS}}"/>
                    <RadioButton Name="rdoBPSPatch" GroupName="{StaticResource GroupPatchType}" Content="BPS"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.BPS}}"/>
                    <RadioButton Name="rdoIPSPatch" GroupName="{StaticResource GroupPatchType}" Content="IPS"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.IPS}}"/>
                    <RadioButton Name="rdoXDPatch" GroupName="{StaticResource GroupPatchType}" Content="xdelta"
                                 IsChecked="{Binding SelectedPatchType, Converter={StaticResource EnumToBoolConverter},
                                 ConverterParameter={x:Static rl:RomPatchType.XDelta}}"/>
                </StackPanel>
                
                <Grid ColumnDefinitions="*, Auto" Margin="3,10">
                    <Grid.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="SelectedPatchType" Converter="{x:Static ObjectConverters.NotEqual}"
                                     ConverterParameter="{x:Static rl:RomPatchType.None}"/>
                            <Binding Path="SelectedPatchType" Converter="{x:Static ObjectConverters.NotEqual}"
                                     ConverterParameter="{x:Static rl:RomPatchType.No_Patch}"/>
                        </MultiBinding>
                    </Grid.IsEnabled>
                    <TextBox Name="txtPatchPath" Grid.Column="0" HorizontalAlignment="Stretch" IsReadOnly="True" 
                             Text="{Binding TxtPatchPath}" PlaceholderText="super tilt bro.ups"/>
                    <Button Name="btnPatchPath" Grid.Column="1" Classes="textbox_inline browseFile"
                            Command="{Binding BrowsePatch_Async}"/>
                </Grid>
            </StackPanel>
            
            <!-- ROW2 - Spacing -->
            <Rectangle Grid.Row="2"/>
            
            <!-- ROW3 - Return Controls -->
            <Grid Grid.Row="3" HorizontalAlignment="Stretch" ColumnDefinitions="*, *" Margin="3,5">
                <st:ViewControlButton Name="btnSavePatch" Grid.Column="0" ButtonFunction="Save" Classes="ExtraControl"
                                      Command="{Binding SavePatch}"/>
                <st:ViewControlButton Name="btnDiscPatch" Grid.Column="1" ButtonFunction="Discard" Classes="ExtraControl"
                                      Command="{Binding DiscPatch}"/>
            </Grid>
            
        </Grid>
    
        <!--Bottom-->
        <!-- <Grid Name="gridBOTTOM" Grid.Row="2" Height="40" ColumnDefinitions="Auto, *, Auto" Background="Gray"> -->
        <!--      -->
        <!-- </Grid> -->
    </Grid>
    
</UserControl>
