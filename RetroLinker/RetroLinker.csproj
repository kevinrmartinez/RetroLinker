<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <AssemblyName>RetroLinkerLib</AssemblyName>
    <VersionPrefix>0.8.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!-- Required to use the LibraryImport attribute -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'" />

  <PropertyGroup>
    <!-- https://docs.avaloniaui.net/docs/deployment/native-aot -->
    <!-- Add to all projects/libraries in use, to ensure AOT compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Microsoft.ClearScript.Windows" Version="7.5.1" Condition="'$(TargetFramework)' == 'net10.0-windows'"/>
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome7" Version="12.0.7" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Zeronia.Diagnostics" Version="12.1.0">
      <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="UserAssets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Licenses\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Update="Translations\resMainView.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resMainView.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resSettingsWindow.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resSettingsWindow.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resMainView.es.resx">
      <DependentUpon>resMainView.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resSettingsWindow.es.resx">
      <DependentUpon>resSettingsWindow.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resAvaloniaOps.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resAvaloniaOps.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resAvaloniaOps.es.resx">
      <DependentUpon>resAvaloniaOps.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resGeneric.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resGeneric.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resGeneric.es.resx">
      <DependentUpon>resGeneric.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resMainExtras.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resMainExtras.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resMainExtras.es.resx">
      <DependentUpon>resMainExtras.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resAboutWindow.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>resAboutWindow.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations\resAboutWindow.es.resx">
      <DependentUpon>resAboutWindow.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  
  <ItemGroup>
    <Compile Update="Translations\resMainView.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resMainView.resx</DependentUpon>
    </Compile>
    <Compile Update="Translations\resSettingsWindow.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resSettingsWindow.resx</DependentUpon>
    </Compile>
    <Compile Update="Translations\resAvaloniaOps.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resAvaloniaOps.resx</DependentUpon>
    </Compile>
    <Compile Update="Translations\resGeneric.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resGeneric.resx</DependentUpon>
    </Compile>
    <Compile Update="Translations\resMainExtras.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resMainExtras.resx</DependentUpon>
    </Compile>
    <Compile Update="Translations\resAboutWindow.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resAboutWindow.resx</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
