<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="clr-namespace:RetroLinker.Styles"
             x:Class="RetroLinker.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <!-- TODO: Customize accent colors (0.9) -->
        <!-- https://docs.avaloniaui.net/docs/basics/user-interface/styling/themes/fluent -->
    </Application.Styles>
             
    <Application.Resources>
        <!-- TODO: Import resources from dedicated files; each file for the kind of resource (UI, Binding converter...) -->
        
        <!-- <Bitmap x:Key="NaNImage">./Assets/Images/NaN.png</Bitmap> | It works, but it's of no use in the current implementation -->
        <!-- Fonts -->
        <FontFamily x:Key="LiberationMonoFont">avares://RetroLinkerLib/Assets/fonts#Liberation Mono</FontFamily>
        
        <!-- TODO: Add globally fixed colors (Resources) (0.9) -->
        <!-- https://docs.avaloniaui.net/docs/app-development/resources -->
        
        <!-- Misc Resources -->
        <x:String x:Key="FounderName">kevinrmartinez</x:String>
        <x:Uri x:Key="LicenseUri">https://www.gnu.org/licenses/gpl-3.0.en.html</x:Uri>
        <x:Uri x:Key="FounderUrl">https://github.com/kevinrmartinez</x:Uri>
        <x:String x:Key="TileIconifierCli">TileIconifier.CLI</x:String>
        <x:Uri x:Key="TileIconifierNetUrl">https://github.com/kevinrmartinez/TileIconifier.Net</x:Uri>
        
        <!-- Binding Converters -->
        <!-- Bools -->
        <!-- Strings -->
        <st:TextToUpper x:Key="TextToUpperConverter"/>
        <st:TextToLower x:Key="TextToLowerConverter"/>
        <st:TextToFullPath x:Key="TextToFullPathConverter"/>
        <!-- Numbers -->
        <st:NumberGreaterThan x:Key="NumberGreaterThanConverter"/>
        <st:NumberLowerThan x:Key="NumberLowerThanConverter"/>
        <!-- Dates -->
        <st:DateToLocal x:Key="DateToLocalConverter"/>
    </Application.Resources>
</Application>
