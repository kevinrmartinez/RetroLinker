Subject: [PATCH] Added list of Stored config files in SettingsView
---
Index: RetroLinker/Views/SettingsView.axaml
IDEA additional info:
Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/RetroLinker/Views/SettingsView.axaml b/RetroLinker/Views/SettingsView.axaml
--- a/RetroLinker/Views/SettingsView.axaml	(revision b6109a3feb656a9fbe5637ef0142ee79213c0e46)
+++ b/RetroLinker/Views/SettingsView.axaml	(date 1794944490614)
@@ -67,16 +67,28 @@
 		</Border>
 		
 		<!-- OTHER SETTINGS -->
-		<Border Classes="SettingCatg">
+		<Border Classes="SettingCatg" MaxHeight="400">
+			<DockPanel>
+				<Label DockPanel.Dock="Top" Content="Stored Config Files"/>
+				<Rectangle DockPanel.Dock="Top" HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="0.5"/>
+				<CheckBox x:Name="chkPrevCONFIG" DockPanel.Dock="Top" Classes="SettingCatg" Content="{x:Static tl:resSettingsWindow.chkPrevCONFIG}" 
+				          IsChecked="{Binding ParentWindow.NewSettings.PrevConfig}"/>
+				
+				<TabControl IsVisible="{Binding ParentWindow.NewSettings.PrevConfig}">
+					<TabItem Header="Config Files" FontSize="16">
+						<st:UserStringList CanAdd="False" MinHeight="200" Items="{Binding ParentWindow.NewSettings.SavedConfigs}"/>
+					</TabItem>
+					<TabItem Header="Append Configs" FontSize="16">
+						<st:UserStringList CanAdd="False" MinHeight="200" Items="{Binding ParentWindow.NewSettings.SavedAppendedConfigs}"/>
+					</TabItem>
+				</TabControl>
+			</DockPanel>
+		</Border>
+		
+		<Border Classes="SettingCatg" IsVisible="False">
 			<StackPanel>
 				<Label Content="{x:Static tl:resSettingsWindow.lblCat_OtherGeneral}"/>
 				<Rectangle HorizontalAlignment="Stretch" Stroke="Gray" StrokeThickness="0.5"/>
-				<Grid Margin="0,3" ColumnDefinitions="*,Auto,*" ShowGridLines="False">
-					<StackPanel Grid.Column="0" Orientation="Vertical">
-						<CheckBox x:Name="chkPrevCONFIG" Classes="SettingCatg" Content="{x:Static tl:resSettingsWindow.chkPrevCONFIG}" 
-						          IsChecked="{Binding ParentWindow.NewSettings.PrevConfig}"/>
-					</StackPanel>
-				</Grid>
 			</StackPanel>
 		</Border>
 
