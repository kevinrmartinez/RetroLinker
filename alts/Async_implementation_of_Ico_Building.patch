-        public IconDirEntry[] IdEntries { get; }
+        public IconDirEntry[] IdEntries { get; init; }
 
         /// <summary> Collection of Bitmaps present in this file, in exception to the 256×256 frame. </summary>
-        public BitmapStructure[] BitmapFrames { get; }
+        public BitmapStructure[] BitmapFrames { get; init; }
         
         /// <summary> An embedded PNG image for the 256×256 frame. </summary>
-        public byte[]? PngFrame { get; }
+        public byte[]? PngFrame { get; init; }
 
         private const int IconDirEntryOffset1 = 6;
         private const int IconDirEntryOffset2 = 16;
         
+        private IcoContainer() {}
+        
         public IcoContainer(SKBitmap initialBitmap, IReadOnlyList<int> sizes)
         {
             IdReserved = IcoReserved;
@@ -98,6 +125,76 @@
             BitmapFrames = bitmaps.ToArray();
         }
 
+        // Builds the bitmaps in parallel. It works, but it's only faster than sequential by ~700µs on a good day
+        public static async Task<IcoContainer> BuildAsync(SKBitmap initialBitmap, IReadOnlyList<int> sizes)
+        {
+            var count = (short)sizes.Count;
+
+            var pngTask = (Task<(IconDirEntry, byte[])>?) null;
+            var tasks = new List<Task<(IconDirEntry, BitmapStructure)>>();
+            var entries = new List<IconDirEntry>();
+            var bitmaps = new List<BitmapStructure>();
+
+            foreach (var size in sizes) {
+                if (size < IcoMaxRes) tasks.Add(Task.Run(() => BuildBitmapAsync(initialBitmap, size)));
+                else pngTask = Task.Run(() => BuildPngAsync(initialBitmap));
+            }
+            
+            var results = await Task.WhenAll(tasks);
+            (IconDirEntry pngEntry, byte[] pngBytes) = await pngTask;   // FIXME
+
+            foreach (var resultPair in results) {
+                entries.Add(resultPair.Item1);
+                bitmaps.Add(resultPair.Item2);
+            }
+            entries.Add(pngEntry);
+            
+            var offset = IconDirEntryOffset1 + (IconDirEntryOffset2 * count);
+            foreach (var entry in entries) {
+                entry.UpdateOffset(offset);
+                offset += entry.BytesInRes;
+            }
+            
+            return new IcoContainer()
+            {
+                IdReserved = IcoReserved,
+                IdType = IcoType.ICO,
+                IdCount = count,
+                IdEntries = entries.ToArray(),
+                BitmapFrames = bitmaps.ToArray(),
+                PngFrame = pngBytes
+            };
+        }
+
+        private static (IconDirEntry, BitmapStructure) BuildBitmapAsync(SKBitmap initialBitmap, int size)
+        {
+            var offsetStub = 128;
+            using var resizedBitmap =
+                initialBitmap.Resize(new SKSizeI(size, size), new SKSamplingOptions(SKFilterMode.Linear));
+            
+            var bitmapStructure = new BitmapStructure(resizedBitmap); 
+            var dirEntry = new IconDirEntry(size, bitmapStructure.SizeInBytes(), ref offsetStub);
+            return (dirEntry, bitmapStructure);
+        }
+
+        private static (IconDirEntry, byte[]) BuildPngAsync(SKBitmap initialBitmap)
+        {
+            // Should only be 256x256
+            var fixedSize = 256;
+            var offsetStub = 128;
+            using var resizedBitmap =
+                initialBitmap.Resize(new SKSizeI(fixedSize, fixedSize), new SKSamplingOptions(SKFilterMode.Linear));
+            
+            using var tempImage = SKImage.FromBitmap(resizedBitmap);
+            using var ms = new MemoryStream();
+            var pixmap = tempImage.PeekPixels();
+            pixmap.Encode(ms, new SKPngEncoderOptions(SKPngEncoderFilterFlags.None, zLibLevel: 1));
+
+            var dirEntry = new IconDirEntry(fixedSize, pixmap.BytesSize, ref offsetStub);
+            
+            return (dirEntry, ms.ToArray());
+        }
+
         public MemoryStream ToStream()
         {
             var stream = new MemoryStream();
@@ -143,7 +240,7 @@
         public int BytesInRes { get; }
         
         /// <summary> Specifies the offset of the DIB or PNG data from the beginning of the file. </summary>
-        public int ImageOffset { get; }
+        public int ImageOffset { get; private set; }
 
         public IconDirEntry(int squareSize, int imageLength, ref int offset)
         {
@@ -175,6 +272,8 @@
         }
 
         public byte[] ToBytes() => ToStream().ToArray();
+        
+        public void UpdateOffset(int offset) => ImageOffset = offset;
     }
     
