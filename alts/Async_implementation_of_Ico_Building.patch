     private const int IcoMaxRes = 256;
     private const int IconDirEntrySize = 16;
     
+    public static async void TestBytes()
+    {
+        var file = "/some/path/2048.png";
+        var outFile = $"{file}.ico";
+        using var image = SKBitmap.Decode(file);
+        IReadOnlyList<int> sizes = [16, 20, 24, 32, 40, 48, 64, 128, 256];
+        
+        var stopWatch = new System.Diagnostics.Stopwatch();
+        stopWatch.Start();
+        var ico1 = new IcoContainer(image,  sizes);
+        var build1 = stopWatch.Elapsed;
+        stopWatch.Restart();
+        var ico2 = await IcoContainer.BuildAsync(image, sizes);
+        var build2 = stopWatch.Elapsed;
+        stopWatch.Restart();
+        // FileOps.WriteAllBytesToFileAsync()
+        await FileOps.WriteAllBytesToFileAsync(outFile, ico1.ToBytes());
+        stopWatch.Stop();
+        var write = stopWatch.Elapsed;
+        
+        Logger.LogDebg($"Ico Sequential Building: {build1.TotalMilliseconds}ms");
+        Logger.LogDebg($"Ico async Building: {build2.TotalMilliseconds}ms");
+        Logger.LogDebg($"Ico Writing: {write.TotalMilliseconds}ms");
+    }
+    
     private enum IcoType {
         ICO = (short)1,
         CUR = (short)2
     }
     
